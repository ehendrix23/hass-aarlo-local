from collections.abc import Mapping
from pathlib import Path
from typing import Protocol
from .cfg import ArloCfg

class Session(Protocol):
    def close(self) -> None: ...

class MFAHelper(Protocol):
    def start(self) -> bool: ...
    def get(self) -> str | None: ...
    def stop(self) -> None: ...

class ArloFacade(Protocol):
    root: Path
    cfg: ArloCfg
    def debug(self, message: str) -> None: ...
    def vdebug(self, message: str) -> None: ...
    def info(self, message: str) -> None: ...
    def warning(self, message: str) -> None: ...
    def error(self, message: str) -> None: ...

class ArloBackEnd:
    _arlo: ArloFacade
    _user_device_id: str | None
    _session: Session | None
    def __init__(self, arlo: ArloFacade) -> None: ...
    def _load_session(self) -> None: ...
    def _login(self) -> bool: ...
    def _relogin(self) -> bool: ...
    def _get_tfa(self) -> MFAHelper | str: ...
    def _request_tuple(self, path: str, method: str = "GET", params: Mapping[str, object] | None = None,
                       headers: dict[str, str] | None = None, stream: bool = False, raw: bool = False,
                       timeout: int | float | None = None, host: str | None = None, authpost: bool = False,
                       cookies: object = None, retry_401: bool = True) -> tuple[int, object]: ...
    @property
    def is_connected(self) -> bool: ...
    @property
    def user_id(self) -> str | None: ...
